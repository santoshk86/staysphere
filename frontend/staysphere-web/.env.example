# Base URL of the StaySphere ASP.NET Core Web API.
# The browser calls the API directly, so this must be reachable from the client.
#
# Local Visual Studio / dotnet run:      http://localhost:5276
# Local Kubernetes (Docker Desktop),
#   via: kubectl -n staysphere port-forward service/staysphere-api 8080:80
#                                        http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
